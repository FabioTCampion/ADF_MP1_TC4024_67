		<DT Nm="FB_VfdProcessControler" AT="2" Cmt="&#10;    FB_ProcessControler&#10;    Purpose: Generic process controller with start/stop latch, status codes,&#10;             PID (OSCAT CTRL_PID), optional reverse action, PV PT1 filter,&#10;             engineering↔% scaling, drive run supervision, and HMI displays.&#10;&#10;    Sequence: Start pulse toggles RUN latch; Stop pulse/level forces stop.&#10;&#10;    Status codes: statusCode INT → 0=Idle, 1=Running, 2=Fault&#10;&#10;    Notes: Includes optional low/high PV “hold” with hysteresis (normal-stop class).&#10;" Ext="1088">
			<SI Nm="allSafetyOK" Tp="BOOL" Ext="768" />
			<SI Nm="anyInterlockOpen" Tp="BOOL" Ext="769" />
			<SI Nm="autoMode" Tp="BOOL" Ext="24" />
